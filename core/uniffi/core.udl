enum FfiTaskStatus {
  "Open",
  "Done"
};

enum FfiTaskSort {
  "UpdatedAtDesc",
  "UpdatedAtAsc",
  "DueAtAsc",
  "DueAtDesc",
  "CreatedAtAsc",
  "CreatedAtDesc"
};

enum FfiAuthMethod {
  "Biometric",
  "Pin",
  "Password"
};

enum FfiSyncAuthState {
  "LocalOnlyReady",
  "AuthenticatedEnrollmentPending",
  "SyncReady",
  "AuthRequired",
  "MisconfiguredOrigin"
};

enum FfiEnrollmentState {
  "LocalOnlyReady",
  "ExistingAccountPending",
  "SyncReady"
};

enum FfiTheme {
  "Light",
  "Dark",
  "System"
};

enum FfiDefaultSort {
  "DueAtAsc",
  "UpdatedAtDesc"
};

enum FfiDisplayDensity {
  "Compact",
  "Comfortable",
  "Spacious"
};

dictionary FfiTask {
  string id;
  string title;
  string body;
  i64? due_at;
  i64? reminder_offset_ms;
  FfiTaskStatus status;
  string? project_id;
  sequence<string> tags;
  i64 created_at;
  i64 updated_at;
  boolean deleted;
  boolean dirty;
};

dictionary FfiTaskList {
  string id;
  string name;
  i64 created_at;
  i64 updated_at;
  boolean deleted;
  boolean dirty;
};

dictionary FfiTaskPatch {
  string? title;
  string? body;
  i64? due_at;
  boolean clear_due_at;
  i64? reminder_offset_ms;
  boolean clear_reminder_offset_ms;
  FfiTaskStatus? status;
  string? project_id;
  boolean clear_project_id;
  sequence<string>? tags;
};

dictionary FfiTaskFilter {
  FfiTaskStatus? status;
  string? project_id;
  sequence<string> tags;
  i64? due_after;
  i64? due_before;
  boolean include_deleted;
};

dictionary FfiBlob {
  sequence<u8> ciphertext;
  sequence<u8> nonce;
};

dictionary FfiTagColor {
  string tag;
  string color;
};

dictionary FfiKeybindings {
  string add_task;
  string search;
  string close_overlay;
  string confirm_rename;
  string delete_task;
  string toggle_done;
};

dictionary FfiPlaintextSettings {
  i32 schema_version;
  string server_url;
  FfiAuthMethod auth_method;
  string language;
  i64 last_sync_cursor;
};

dictionary FfiVaultSettings {
  i32 schema_version;
  FfiTheme theme;
  FfiDefaultSort default_sort;
  boolean show_completed;
  i32 default_reminder_minutes;
  sequence<FfiTagColor> tag_colors;
  FfiDisplayDensity display_density;
  i32 first_day_of_week;
  string notification_sound;
  FfiKeybindings keybindings;
  boolean show_share_revocation_warning;
};

dictionary FfiSharedTaskRecipient {
  string task_id;
  string recipient_id;
  FfiBlob wrapped_task_key;
  i64 created_at;
  i64? revoked_at;
};

dictionary FfiSharedTaskState {
  string task_id;
  string? owner_id;
  sequence<u8> task_key;
  sequence<FfiSharedTaskRecipient> recipients;
  i64? accepted_at;
  i64? revoked_at;
};

dictionary FfiSharedTaskInvite {
  string task_id;
  string owner_id;
  string recipient_id;
  FfiBlob wrapped_task_key;
};

dictionary FfiSharedTaskRecipientKey {
  string recipient_id;
  sequence<u8> public_key;
};

dictionary FfiSyncStatus {
  u64 dirty_count;
  u64 retry_queue_depth;
  i64 cursor;
};

dictionary FfiRetryQueueEntry {
  string task_id;
  i64 attempt;
  i64 next_retry;
};

dictionary FfiBlobPush {
  string task_id;
  FfiBlob blob;
};

dictionary FfiRemoteBlob {
  string task_id;
  FfiBlob blob;
  i64 updated_at;
};

dictionary FfiPushResponse {
  sequence<string> accepted_task_ids;
  sequence<string> failed_task_ids;
};

dictionary FfiPullResponse {
  sequence<FfiRemoteBlob> blobs;
  i64 cursor;
};

dictionary FfiSyncResult {
  u64 pushed;
  u64 pulled;
  u64 failed;
  i64? cursor;
};

callback interface FfiSyncClient {
  [Throws=FfiCoreError]
  FfiPushResponse push_blobs(sequence<FfiBlobPush> blobs);
  [Throws=FfiCoreError]
  FfiPushResponse delete_blobs(sequence<string> task_ids);
  [Throws=FfiCoreError]
  FfiPullResponse pull_blobs(i64 since);
};

dictionary FfiDeviceKeypair {
  sequence<u8> private_key;
  sequence<u8> public_key;
};

dictionary FfiLocalAccountBootstrap {
  sequence<u8> device_private_key;
  sequence<u8> device_public_key;
  sequence<u8> account_data_key;
};

dictionary FfiWrappedAccountDataKeyPayload {
  sequence<u8> sender_public_key;
  sequence<u8> recipient_public_key;
  FfiBlob wrapped_account_data_key;
};

callback interface FfiPlatform {
  [Throws=FfiCoreError]
  void store_key(string id, sequence<u8> bytes);
  [Throws=FfiCoreError]
  sequence<u8> load_key(string id);
  [Throws=FfiCoreError]
  void delete_key(string id);
  boolean network_available();
};

[Error]
interface FfiCoreError {
  CryptoError(string error_message);
  DatabaseError(string error_message);
  SyncError(string error_message);
  PlatformError(string error_message);
  SettingsError(string error_message);
  SerializationError(string error_message);
  InvalidUuid(string error_message);
  InvalidNonce(string error_message);
  InvalidPatch(string error_message);
};

interface FfiTaskManagerCore {
  [Throws=FfiCoreError]
  constructor(string database_path);

  [Throws=FfiCoreError]
  FfiTaskList create_list(string name);
  [Throws=FfiCoreError]
  sequence<FfiTaskList> list_task_lists();
  [Throws=FfiCoreError]
  FfiTaskList update_list(string list_id, string name);
  [Throws=FfiCoreError]
  void delete_list(string list_id);

  [Throws=FfiCoreError]
  FfiTask create_task(string title, string body, i64? due_at);
  [Throws=FfiCoreError]
  FfiTask create_task_with_options(string title, string body, i64? due_at, string? project_id, sequence<string> tags);
  [Throws=FfiCoreError]
  FfiTask get_task(string task_id);
  [Throws=FfiCoreError]
  FfiTask update_task(string task_id, FfiTaskPatch patch);
  [Throws=FfiCoreError]
  void delete_task(string task_id);
  [Throws=FfiCoreError]
  sequence<FfiTask> list_tasks(FfiTaskFilter filter, FfiTaskSort sort);
  [Throws=FfiCoreError]
  sequence<FfiTask> search_tasks(string query);

  [Throws=FfiCoreError]
  FfiSharedTaskRecipient share_task_with_recipient(string task_id, string recipient_id, sequence<u8> recipient_public_key, sequence<u8> owner_private_key);
  [Throws=FfiCoreError]
  FfiSharedTaskState accept_shared_task_invite(FfiSharedTaskInvite invite, sequence<u8> owner_public_key, sequence<u8> recipient_private_key);
  [Throws=FfiCoreError]
  FfiSharedTaskState revoke_shared_task_recipient(string task_id, string recipient_id, sequence<FfiSharedTaskRecipientKey> remaining_recipient_public_keys, sequence<u8> owner_private_key);
  [Throws=FfiCoreError]
  FfiSharedTaskState shared_task_state(string task_id);
  string shared_task_revocation_notice();

  [Throws=FfiCoreError]
  FfiVaultSettings vault_settings();
  [Throws=FfiCoreError]
  FfiVaultSettings update_vault_settings(FfiVaultSettings settings);
  [Throws=FfiCoreError]
  FfiSyncStatus sync_status();
  [Throws=FfiCoreError]
  sequence<FfiRetryQueueEntry> retry_queue_entries();
  [Throws=FfiCoreError]
  FfiRetryQueueEntry queue_sync_retry(string task_id, i64 now);
  [Throws=FfiCoreError]
  FfiSyncResult sync_run(boolean network_available, FfiSyncClient client, sequence<u8> data_key);
};

namespace taskmanager_core {
  [Throws=FfiCoreError]
  FfiBlob encrypt_task_blob(FfiTask task, sequence<u8> key);
  [Throws=FfiCoreError]
  FfiTask decrypt_task_blob(FfiBlob blob, sequence<u8> key);
  [Throws=FfiCoreError]
  i64? schedulable_notification_at(FfiTask task, i64 now_ms);
  sequence<u8> generate_account_data_key();

  FfiDeviceKeypair generate_ffi_device_keypair();
  FfiLocalAccountBootstrap generate_local_account_bootstrap();
  [Throws=FfiCoreError]
  sequence<u8> device_public_key_from_private_key(sequence<u8> private_key);
  [Throws=FfiCoreError]
  FfiBlob wrap_account_data_key(sequence<u8> data_key, sequence<u8> peer_public_key, sequence<u8> own_private_key);
  [Throws=FfiCoreError]
  sequence<u8> unwrap_account_data_key(FfiBlob wrapped, sequence<u8> peer_public_key, sequence<u8> own_private_key);
  string device_private_key_id();
  string account_data_key_id();
  string auth_access_token_id();
  string auth_refresh_token_id();
  string auth_sync_origin_id();
  string auth_account_id_id();

  [Throws=FfiCoreError]
  string normalize_ffi_sync_server_url(string server_url);
  [Throws=FfiCoreError]
  string ffi_sync_server_origin(string server_url);
  FfiSyncAuthState ffi_sync_auth_state(FfiPlatform platform, string server_url);
  FfiEnrollmentState ffi_existing_account_enrollment_state(FfiPlatform platform);
  [Throws=FfiCoreError]
  FfiEnrollmentState ffi_begin_existing_account_enrollment(FfiPlatform platform);
  [Throws=FfiCoreError]
  FfiWrappedAccountDataKeyPayload create_ffi_wrapped_account_data_key_payload(sequence<u8> account_data_key, sequence<u8> recipient_public_key, sequence<u8> sender_private_key);
  [Throws=FfiCoreError]
  FfiEnrollmentState accept_ffi_wrapped_account_data_key_payload(FfiPlatform platform, FfiWrappedAccountDataKeyPayload payload);

  [Throws=FfiCoreError]
  FfiPlaintextSettings read_plaintext_settings(string path);
  [Throws=FfiCoreError]
  void write_plaintext_settings(string path, FfiPlaintextSettings settings);
};
