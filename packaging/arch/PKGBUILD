# Maintainer: Matthew Jiang <matthewyjiang@users.noreply.github.com>
pkgname=tsk-linux
pkgver=0.3.0
pkgrel=1
pkgdesc="GTK/libadwaita desktop client for the local-first encrypted task manager"
arch=("x86_64")
url="https://github.com/matthewyjiang/tasks"
license=("custom")
depends=("gcc-libs" "glibc" "gtk4" "libadwaita" "libsecret")
makedepends=("cargo")
source=()
sha256sums=()

_repo_root() {
  if [[ -f "$startdir/../../linux/Cargo.toml" ]]; then
    printf '%s\n' "$startdir/../.."
  else
    printf '%s\n' "$startdir"
  fi
}

pkgver() {
  awk -F '"' '/^version = / { print $2; exit }' "$(_repo_root)/linux/Cargo.toml"
}

prepare() {
  cd "$(_repo_root)"
  cargo fetch --locked
}

build() {
  cd "$(_repo_root)"
  cargo build --release --locked -p tsk-linux
}

check() {
  cd "$(_repo_root)"
  cargo test --locked -p tsk-linux
}

package() {
  local repo_root
  repo_root="$(_repo_root)"

  install -Dm755 "$repo_root/target/release/tsk-gui" "$pkgdir/usr/bin/tsk-gui"
  install -Dm644 "$repo_root/linux/resources/io.github.matthewyjiang.tsk.desktop" \
    "$pkgdir/usr/share/applications/io.github.matthewyjiang.tsk.desktop"
  install -Dm644 "$repo_root/linux/resources/io.github.matthewyjiang.tsk.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.matthewyjiang.tsk.metainfo.xml"
}
