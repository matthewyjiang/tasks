# Maintainer: Matthew Jiang <matthewyjiang@users.noreply.github.com>
pkgname=tsk-linux
pkgver=0.3.3
pkgrel=2
pkgdesc="GTK/libadwaita desktop client for the local-first encrypted task manager"
arch=("x86_64")
url="https://github.com/matthewyjiang/tasks"
license=("custom")
depends=("gcc-libs" "glibc" "gtk4" "libadwaita" "libsecret" "sqlite")
makedepends=("cargo" "sqlite")
source=()
sha256sums=()
options=("!lto")

_repo_root() {
  if [[ -f "$startdir/../../linux/Cargo.toml" ]]; then
    printf '%s\n' "$startdir/../.."
  else
    printf '%s\n' "$startdir"
  fi
}

pkgver() {
  awk -F '"' '/^version = / { print $2; exit }' "$(_repo_root)/linux/Cargo.toml"
}

prepare() {
  cd "$(_repo_root)"
  cargo fetch --locked
}

_prepare_rust_build_env() {
  # Arch's Rust package may prefer lld for Rust final links under makepkg, and
  # makepkg's LTO flags can also leak into native build scripts. ring's generated
  # static objects are sensitive to that combination, so keep the normal debug
  # remapping flags but use the system linker without LTO for Cargo builds.
  export RUSTFLAGS="${RUSTFLAGS:-} -C linker-features=-lld"
  export CFLAGS="${CFLAGS// -flto=auto/}"
  export CXXFLAGS="${CXXFLAGS// -flto=auto/}"
  export LDFLAGS="${LDFLAGS// -flto=auto/}"
}

build() {
  cd "$(_repo_root)"
  _prepare_rust_build_env
  cargo build --release --locked -p tsk-linux
}

check() {
  cd "$(_repo_root)"
  _prepare_rust_build_env
  cargo test --locked -p tsk-linux
}

package() {
  local repo_root
  repo_root="$(_repo_root)"

  local target_dir
  target_dir="${CARGO_TARGET_DIR:-$repo_root/target}"

  install -Dm755 "$target_dir/release/tsk-gui" "$pkgdir/usr/bin/tsk-gui"
  install -Dm644 "$repo_root/linux/resources/io.github.matthewyjiang.tsk.desktop" \
    "$pkgdir/usr/share/applications/io.github.matthewyjiang.tsk.desktop"
  install -Dm644 "$repo_root/linux/resources/io.github.matthewyjiang.tsk.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.matthewyjiang.tsk.metainfo.xml"
}
